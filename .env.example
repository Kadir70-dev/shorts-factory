# ---- Director Brain ----
# Backend: "cli" = local `claude` CLI on your Claude MAX plan (no API billing);
#          "api" = Anthropic Messages API (needs ANTHROPIC_API_KEY, scales).
DIRECTOR_MODE=live
DIRECTOR_BACKEND=cli
DIRECTOR_RESEARCH=1
DIRECTOR_CLI_MODEL=opus
CLAUDE_BIN=claude
# only used when DIRECTOR_BACKEND=api:
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-4-8
DIRECTOR_MAX_TOKENS=8000

# ---- OpenRouter (OPTIONAL backup / augmentation — Claude CLI stays primary) ----
# Cheap OpenAI-compatible fallback used for: AI image-prompt enhancement, backup
# LLM routing, and Director failure recovery when the Claude CLI crashes. Leave
# OPENROUTER_API_KEY blank to disable the whole layer (silent no-op — the pipeline
# behaves exactly as before). Get a key at https://openrouter.ai/keys .
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Voice ----
# Local cloned voice only: Chatterbox → Apache-2.0 OpenF5 → the host's fine-tuned
# Piper model. Identity, reference transcript, and model paths are pinned in
# config/voice/profile.yaml. A missing clone fails the render.
# TTS_MODELS_DIR=                           # blank → <repo>/data/models

# ---- B-roll ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Cinematic AI images (Google AI Studio ONLY; OpenAI is NOT used) ----
# Get a key at https://aistudio.google.com/apikey . NOTE: image generation needs
# BILLING enabled — the free tier is 0 image requests. Without it, AI beats fall
# back to real footage automatically. AI_IMAGE_DEMO=true = free offline plates.
GOOGLE_API_KEY=
# GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
# GOOGLE_IMAGEN_MODEL=imagen-4.0-generate-001
# Hugging Face Inference Providers = FREE cinematic FLUX images, slotted BETWEEN
# Google and Pollinations. Free with a token that has the "Inference Providers"
# permission (https://huggingface.co/settings/tokens). FLUX.1-dev is preferred;
# FLUX.1-schnell is the fast free fallback (served by hf-inference). Image-only —
# never the director brain. Either env name works (HF_TOKEN wins). Blank → skipped.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_IMAGE_PROVIDER=hf-inference
# HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
# HUGGINGFACE_IMAGE_MODEL_FAST=black-forest-labs/FLUX.1-schnell
# Pollinations = FREE image fallback (no key) used when Google + HF are unavailable.
# Works out of the box on most IPs; a free token (auth.pollinations.ai) lifts the
# rate limit if your IP is throttled. Set POLLINATIONS_ENABLED=false to disable.
# POLLINATIONS_ENABLED=true
# POLLINATIONS_MODEL=flux
# POLLINATIONS_TOKEN=
# AI_IMAGE_DEMO=false

# ---- Local ComfyUI image backend (text->image on THIS machine) ----
# When COMFYUI_ENABLED=1, this is the PRIMARY image generator (a DreamShaper_8_
# pruned SD1.5 text->image graph on a local ComfyUI at :8188). Stills land in the
# normal cache so all downstream editing is unchanged. On ANY failure (ComfyUI not
# running, timeout, etc.) the pipeline falls back automatically to the existing
# chain: Google AI Studio -> HuggingFace FLUX -> Pollinations -> footage.
# (COMFYUI_MODE may be "remote" with a tunnel URL, but local is the default.)
COMFYUI_ENABLED=0
COMFYUI_MODE=local
# Either COMFYUI_BASE_URL or COMFYUI_URL works (alias); COMFYUI_BASE_URL wins if both set.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=900
# Optional tunables (defaults shown):
# COMFYUI_CHECKPOINT=DreamShaper_8_pruned.safetensors
# COMFYUI_WIDTH=512
# COMFYUI_HEIGHT=896
# COMFYUI_STEPS=25
# COMFYUI_CFG=7.0
# COMFYUI_SAMPLER=dpmpp_2m
# COMFYUI_SCHEDULER=karras
# --- CPU-first LCM optimization (Phase 1, opt-in, default OFF) ---
# On a GPU-less i5/12GB box the stock 25-step graph is ~3-5 min/image. COMFYUI_LCM=1
# inserts an LCM-LoRA and renders the SAME checkpoint in ~8 steps (~35-60s on CPU).
# Drop lcm-lora-sdv1-5.safetensors in ComfyUI's models/loras/. OFF = unchanged.
# Launch ComfyUI with scripts/comfyui_cpu.sh; sample graph in data/comfy/cpu_lcm_txt2img.json.
COMFYUI_LCM=0
# COMFYUI_LCM_LORA=lcm-lora-sdv1-5.safetensors
# COMFYUI_LCM_STEPS=8
# COMFYUI_LCM_CFG=2.0
# COMFYUI_LCM_SAMPLER=lcm
# COMFYUI_LCM_SCHEDULER=sgm_uniform
# Lower peak RAM on 12GB: tiled VAE decode.
# COMFYUI_VAE_TILED=1
# COMFYUI_VAE_TILE_SIZE=512
# Anime/cartoon: smaller res + an anime checkpoint + a negative that does NOT ban
# anime (the global default bars cartoon/anime/3d for the photoreal doc look).
# COMFYUI_CHECKPOINT=<your_anime_lcm_model>.safetensors
# COMFYUI_NEGATIVE=lowres, bad anatomy, bad hands, extra fingers, watermark, text, jpeg artifacts

# ---- Premium AI video (leave blank to disable) ----
VEO3_API_KEY=
SEEDANCE_API_KEY=

# ---- AI VIDEO (Pika / Veo3 / Seedance) — disabled by default ----
# Master switch for ALL AI-video generation. OFF keeps the pipeline a stable,
# CPU-friendly local shorts factory (local AI images + real footage + ffmpeg
# motion, no AI video). To re-enable: AI_VIDEO_ENABLED=1 AND set PIKA_API_KEY
# (served via fal.ai's async queue). Costs nothing while disabled.
AI_VIDEO_ENABLED=0
PIKA_API_KEY=
# PIKA_API_BASE=https://queue.fal.run
# PIKA_MODEL=fal-ai/pika/v2.2/text-to-video
# PIKA_RESOLUTION=720p
# PIKA_ASPECT_RATIO=9:16

# ---- Picsart IMAGE-TO-VIDEO (opt-in cinematic motion) ----
# Animates the still LOCAL ComfyUI already generates into a SHORT (3–5s) cinematic
# clip — HERO / high-emotion / anime / dramatic beats only. Fully additive and OFF
# by default: with ENABLE_IMAGE_TO_VIDEO=0 the scene director never allocates an
# ai_video beat and Picsart is never called, so the pipeline behaves EXACTLY as
# before. To turn on: ENABLE_IMAGE_TO_VIDEO=1 AND set PICSART_API_KEY. On a missing
# key or ANY failure the beat degrades to the still (Ken Burns) → real footage —
# never breaks. wan-2.7 + 480p is the cheap/laptop-friendly default; set
# PICSART_MODEL to a Google Veo URN (e.g. urn:air:google:model:google:
# veo-3.1-image-to-video@1) for premium quality at higher cost. MAX_AI_VIDEO_SCENES
# hard-caps clips per short (cost/CPU guard).
ENABLE_IMAGE_TO_VIDEO=0
AI_VIDEO_PROVIDER=picsart
PICSART_API_KEY=
PICSART_MODEL=wan-2.7
MAX_AI_VIDEO_SCENES=2
# Optional quality override — premium model used ONLY for the single hero beat
# (highest-emotion ai_video scene). Blank → every clip uses PICSART_MODEL. Friendly
# names (wan-2.7, veo-3.1-fast, veo-3.1, veo-2.0) resolve to Picsart URNs; a raw
# URN also works.
PICSART_HERO_MODEL=
# Optional tunables (defaults shown):
# PICSART_API_BASE=https://genai-api.picsart.io
# PICSART_I2V_PATH=/v1/image2video
# PICSART_QUALITY=480p
# PICSART_LENGTH_S=4.0
# PICSART_AUDIO=false
# PICSART_POLL_SECONDS=5.0
# PICSART_MAX_WAIT_SECONDS=240.0

# ---- Visual accuracy — narration↔visual GROUNDING LOCK (global rule) ----
# Make every visual show EXACTLY what the line says (point-to-point), across ALL
# niches (history, politics, business, sports, crime, cybersecurity, finance,
# documentary, dark facts, anime). STRICT changes two things:
#   • the Director authors exact, event-grounded keywords per sentence;
#   • the resolver tries those EXACT terms first, then an AI RECREATION of the
#     exact event, and only then generic stock — and never repeats a clip.
# Generic b-roll stays as a non-black safety net (demoted, not forbidden), and
# everyday-realism beats (grocery/streets/crowds) stay real footage. Leave at the
# defaults below for the original behavior; set VISUAL_ACCURACY_MODE=strict to
# turn the lock on (SCENE_GROUNDING / NARRATION_TO_VISUAL_LOCK also enable it).
VISUAL_ACCURACY_MODE=strict
SCENE_GROUNDING=true
NARRATION_TO_VISUAL_LOCK=true

# ---- Render backend (CPU / stability) ----
# "ffmpeg" = pure ffmpeg only (no Node/Remotion) — most stable on a laptop; adds
# cinematic zoom/shake/pan + duration-preserving dip transitions. "auto" = try
# Remotion first, then fall back to ffmpeg. FFMPEG_MOTION_BLUR=1 adds filmic
# motion blur (costs CPU).
RENDER_BACKEND=ffmpeg
FFMPEG_MOTION_BLUR=0

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
REMOTION_RENDER_URL=http://localhost:3001
# PATHS: leave these BLANK. This file is shared by local runs and by Compose
# (docker-compose.yml uses `env_file: .env`), so an absolute path here is wrong in
# one of the two runtimes — that is what produced `PermissionError: '/repo'` on a
# local box. app/config.py resolves the root per runtime: source checkout locally,
# /repo inside the container (Compose also pins these explicitly). Set PROJECT_ROOT
# only if you deliberately want the repo root somewhere else.
# PROJECT_ROOT=
# DATA_DIR=
# DATABASE_URL=

# ---- Uploads (Phase 5) ----
# Blank → <project root>/config/secrets/youtube_client_secret.json
# YOUTUBE_CLIENT_SECRET_PATH=

# =========================================================================== #
# PHASE 2A — Gemini-powered finance trend intelligence (topic selection)
# =========================================================================== #
# An ISOLATED decision engine that picks the topic for the next Short. It does
# not render, upload or schedule anything, and the frozen render core is
# untouched. Every connector below is OPTIONAL and independently switchable; the
# pipeline keeps working when any subset is unavailable.
#
# Out of the box (no keys at all) the engine runs on free finance RSS with the
# deterministic ranker. Add GEMINI_API_KEY for the reasoning layer and
# YOUTUBE_DATA_API_KEY for real competition analysis.

TI_ENABLED=true
TI_REGION=US
TI_DEFAULT_CHANNEL=usa_trading
# Enqueue the winning topic into the EXISTING Director pipeline. OFF by default:
# Phase 2A ships as a decision engine, not a producer.
TI_AUTO_ENQUEUE=false

# ---- Gemini (REQUIRED for the ranking/reasoning layer; free tier available) ----
# https://aistudio.google.com/apikey . With no key the deterministic ranker runs
# instead — the system still selects a topic, just without qualitative reasoning.
# GEMINI_MODEL must be a STABLE production model; never pin a preview model here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RANKER_ENABLED=true
GEMINI_GROUNDING_ENABLED=true
GEMINI_MAX_CANDIDATES=30
GEMINI_MAX_RETRIES=3
# Hard daily spend ceiling in USD, enforced BEFORE each call. 0 = unlimited.
GEMINI_DAILY_BUDGET_USD=1.0
# How far Gemini may move a QUALITATIVE sub-score (0 = advisory only, 1 = fully
# trusted). Momentum/freshness/credibility/competition/risk are never blended,
# and the overall score is always recomputed in code.
GEMINI_INFLUENCE=0.5
# List price per million tokens, for cost accounting only. Update from the
# pricing page; wrong values affect budget math, never correctness.
# GEMINI_INPUT_COST_PER_MTOK=0.30
# GEMINI_OUTPUT_COST_PER_MTOK=2.50

# ---- Google Trends (OPTIONAL, OFF — NOT free or universally available) ----
# There is NO free, officially supported public Google Trends API. Unofficial
# scrapers break without notice and are not a hidden production dependency here.
# To enable, point GOOGLE_TRENDS_BASE_URL at a connector YOU approve. Expected
# response shape is documented in providers/google_trends.py. When unavailable a
# provider failure is recorded and the run continues without search interest.
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_REGION=US
GOOGLE_TRENDS_BASE_URL=
GOOGLE_TRENDS_API_KEY=

# ---- YouTube Data API v3 (RECOMMENDED, free quota: 10,000 units/day) ----
# console.cloud.google.com -> enable "YouTube Data API v3" -> create an API key.
# Discovery uses search.list on finance keywords (NOT chart=mostPopular), then
# videos.list + channels.list for statistics. ~804 units per default run
# (search.list costs 100 units/call), so roughly 12 runs/day fit the free quota.
# Responses are cached for TI_CACHE_TTL_S. Without a key, competition scoring
# returns a neutral 50 and the report says the data was unavailable.
YOUTUBE_DATA_API_KEY=
YOUTUBE_TRENDS_ENABLED=true
YOUTUBE_REGION=US
YOUTUBE_RELEVANCE_LANGUAGE=en
# YOUTUBE_MAX_QUERIES=8
# YOUTUBE_RESULTS_PER_QUERY=25

# ---- Reddit (OPTIONAL, OFF, free) ----
# reddit.com/prefs/apps -> create a "script" app -> client id + secret.
# Official OAuth2 client-credentials only. Reddit is a PUBLIC-INTEREST signal:
# upvotes are never treated as evidence that a claim is true, and a social-only
# factual claim is penalized or blocked in code.
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:shorts-factory.topic-intelligence:2a (by /u/YOURNAME)
# TI_SUBREDDITS=stocks,investing,wallstreetbets,options,SecurityAnalysis,economics,finance,algotrading,quant,Bitcoin,CryptoCurrency

# ---- X / Twitter (OPTIONAL, OFF, PAID) ----
# Official API only — no scraping. Recent search requires a PAID X plan; the free
# tier does not include it. Auto-disabled when X_BEARER_TOKEN is empty, and a
# 401/403 is treated as a clean skip. Never a hard dependency.
X_TRENDS_ENABLED=false
X_BEARER_TOKEN=

# ---- Economic calendar (OPTIONAL, OFF; free tier varies by vendor) ----
# Vendor-neutral. ECONOMIC_CALENDAR_PROVIDER is one of:
#   tradingeconomics  (guest:guest returns a tiny sample; real use is PAID)
#   finnhub           (free tier available, finnhub.io)
#   generic_json      (any endpoint you host; set ECONOMIC_CALENDAR_BASE_URL)
# previous/forecast/actual values are passed through EXACTLY as published and
# stay empty when absent — Gemini is never asked to invent a macro number.
ECONOMIC_CALENDAR_ENABLED=false
ECONOMIC_CALENDAR_PROVIDER=
ECONOMIC_CALENDAR_API_KEY=
ECONOMIC_CALENDAR_BASE_URL=

# ---- Finance news (ON by default, FREE, no key required) ----
# RSS is parsed with the stdlib, so the default feed list works with no key.
# NEWS_API_KEY (newsapi.org) is OPTIONAL and adds NewsAPI on top; its free tier
# is development-only and rate-limited. Syndicated copies of one wire story are
# collapsed into a single independent source.
FINANCE_NEWS_ENABLED=true
NEWS_API_KEY=
# TI_NEWS_RSS_FEEDS=<comma-separated; defaults to Fed + BLS + CNBC + MarketWatch>

# ---- Funnel sizing (cost control: 200-500 raw -> 20-40 clusters -> 10-20 -> 1) ----
TI_LOOKBACK_HOURS=48
TI_MAX_RAW_SIGNALS=500
TI_MAX_CLUSTERS=40
TI_MAX_FINALISTS=15
TI_MIN_ELIGIBLE_CANDIDATES=1

# ---- Deduplication windows ----
TOPIC_EXACT_DEDUP_DAYS=365
TOPIC_SEMANTIC_DEDUP_DAYS=90
TOPIC_SIMILARITY_THRESHOLD=0.86
ANGLE_SIMILARITY_THRESHOLD=0.90
# TOPIC_CLUSTER_THRESHOLD=0.55

# ---- Resilience ----
TI_PROVIDER_TIMEOUT_S=20
TI_HTTP_RETRIES=3
TI_CACHE_TTL_S=900
TI_CIRCUIT_FAILURE_THRESHOLD=3
TI_CIRCUIT_RESET_S=300
TI_STALE_AFTER_HOURS=12
# Phase 1 comparison policy. OFF by default until benchmarks justify promotion.
VISUAL_INTELLIGENCE_ENABLED=0
