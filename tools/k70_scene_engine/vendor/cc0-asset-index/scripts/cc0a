#!/usr/bin/env python3
"""cc0a — CC0 asset index CLI.

Usage:
  cc0a reindex                      run all indexers -> data/assets.jsonl + data/index.sqlite
  cc0a search <query> [--kind K]    keyword search over name/tags/description
  cc0a info <asset_id>              show full record
  cc0a download <asset_id> [--format F] [--dir D]   fetch asset into ./assets/cc0/<provider>/<slug>/

Design notes:
  - data/assets.jsonl is canonical (git-friendly, greppable).
  - data/index.sqlite is a derived cache for fast LIKE queries; rebuild anytime.
  - Every downloaded asset dir gets a LICENSE.json copied from its record.
"""
import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "data")
JSONL = os.path.join(DATA, "assets.jsonl")
SQLITE = os.path.join(DATA, "index.sqlite")


def load_jsonl(path=JSONL):
    with open(path) as f:
        return [json.loads(line) for line in f if line.strip()]


def build_sqlite(records, path=SQLITE):
    if os.path.exists(path):
        os.remove(path)
    db = sqlite3.connect(path)
    db.execute(
        "CREATE TABLE assets (id TEXT PRIMARY KEY, name TEXT, kind TEXT, "
        "tags TEXT, description TEXT, formats TEXT, record TEXT)"
    )
    db.executemany(
        "INSERT INTO assets VALUES (?,?,?,?,?,?,?)",
        [
            (
                r["id"], r["name"], r["kind"], ",".join(r["tags"]),
                r["description"], ",".join(r["formats"]), json.dumps(r),
            )
            for r in records
        ],
    )
    db.commit()
    db.close()


def cmd_reindex(_args):
    indexers = ["polyhaven.py", "kenney.py", "quaternius.py"]
    outputs = []
    for script in indexers:
        out = os.path.join(DATA, script.replace(".py", ".jsonl"))
        subprocess.run([sys.executable, os.path.join(ROOT, "indexers", script), out], check=True)
        outputs.append(out)
    records = []
    for out in outputs:
        records.extend(load_jsonl(out))
    # dedupe by id, sort by provider/name
    seen = {}
    for r in records:
        seen[r["id"]] = r
    records = sorted(seen.values(), key=lambda r: r["id"])
    with open(JSONL, "w") as f:
        for r in records:
            f.write(json.dumps(r) + "\n")
    build_sqlite(records)
    print(f"index: {len(records)} assets -> {JSONL} + {SQLITE}")


def cmd_search(args):
    terms = [t.lower() for t in args.query]
    if os.path.exists(SQLITE):
        db = sqlite3.connect(SQLITE)
        rows = db.execute("SELECT record FROM assets").fetchall()
        records = [json.loads(r[0]) for r in rows]
    else:
        records = load_jsonl()

    def score(r):
        hay = " ".join([r["name"], " ".join(r["tags"]), r["description"]]).lower()
        if not all(t in hay for t in terms):
            return -1
        # rank: name hits > tag hits > description hits; kits get a small boost
        s = sum(3 for t in terms if t in r["name"].lower())
        s += sum(2 for t in terms if t in r["tags"])
        s += sum(1 for t in terms if t in r["description"].lower())
        if r["kind"] == "kit":
            s += 1
        # grade weighting: gold up, archive hidden unless --all
        s += {"gold": 2, "silver": 0, "bronze": -1, "archive": -100}.get(r.get("grade"), 0)
        return s

    hits = [(score(r), r) for r in records]
    hits = [h for h in hits if h[0] >= 0 and (args.all or h[1].get("grade") != "archive")]
    if args.kind:
        hits = [h for h in hits if h[1]["kind"] == args.kind]
    hits.sort(key=lambda h: -h[0])
    for s, r in hits[: args.limit]:
        print(f"{r['id']:45} [{r['kind']:8}] {r['name']}  ({', '.join(r['formats'])})")
    print(f"-- {len(hits)} match(es)", file=sys.stderr)


def cmd_info(args):
    for r in load_jsonl():
        if r["id"] == args.asset_id:
            print(json.dumps(r, indent=2))
            return
    sys.exit(f"not found: {args.asset_id}")


def _download(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "cc0-asset-index/0.1"})
    with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as f:
        while True:
            chunk = resp.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)


def cmd_download(args):
    rec = None
    for r in load_jsonl():
        if r["id"] == args.asset_id:
            rec = r
            break
    if not rec:
        sys.exit(f"not found: {args.asset_id}")
    provider, slug = rec["id"].split(":", 1)
    dest_dir = os.path.join(args.dir, "cc0", provider, slug)
    os.makedirs(dest_dir, exist_ok=True)

    downloaded = []
    if provider == "polyhaven":
        fmt = args.format or ("blend" if rec["kind"] == "model" else ("hdr" if rec["kind"] == "hdri" else "jpg"))
        req = urllib.request.Request(rec["source"]["files_api"], headers={"User-Agent": "cc0-asset-index/0.1"})
        files = json.load(urllib.request.urlopen(req, timeout=60))
        key = {"glb": "gltf", "gltf": "gltf", "hdr": "hdr", "exr": "hdri"}.get(fmt, fmt)
        section = files.get(key) or files.get(fmt)
        if not section:
            sys.exit(f"format '{fmt}' not available; sections: {list(files.keys())}")
        res = args.res or ("1k" if "1k" in section else sorted(section.keys())[0])
        if res not in section:
            sys.exit(f"resolution '{res}' not available; have: {list(section.keys())}")
        entry = section[res]
        sub = entry.get(fmt) or entry.get(key) or next(iter(entry.values()))
        if not isinstance(sub, dict) or "url" not in sub:
            sys.exit(f"unexpected files payload for {res}: {list(entry.keys())}")
        ext = os.path.splitext(sub["url"].split("?")[0])[1] or f".{fmt}"
        fname = f"{slug}_{res}{ext}"
        print(f"downloading {fname} ({sub.get('size', 0) / 1e6:.1f} MB)...", file=sys.stderr)
        _download(sub["url"], os.path.join(dest_dir, fname))
        downloaded.append(fname)
        # gltf/blend may carry dependent files (textures, .bin) — fetch them too
        for rel, inc in (sub.get("include") or {}).items():
            target = os.path.join(dest_dir, rel)
            os.makedirs(os.path.dirname(target) or dest_dir, exist_ok=True)
            _download(inc["url"], target)
            downloaded.append(rel)
    else:
        # Kenney / Quaternius: landing page has the canonical download link; print it.
        print(f"Download page: {rec['source']['url']}")
        print("(Pack downloads are zip links on the provider page; open or curl the link found there.)")

    with open(os.path.join(dest_dir, "LICENSE.json"), "w") as f:
        json.dump(rec, f, indent=2)
    print(f"-> {dest_dir}")
    for d in downloaded:
        print(f"   {d}")


def main():
    ap = argparse.ArgumentParser(prog="cc0a")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("reindex")
    p = sub.add_parser("search")
    p.add_argument("query", nargs="+")
    p.add_argument("--kind", choices=["kit", "model", "hdri", "material", "scene"])
    p.add_argument("--limit", type=int, default=15)
    p.add_argument("--all", action="store_true", help="include archived (grade=archive) records")
    p = sub.add_parser("info")
    p.add_argument("asset_id")
    p = sub.add_parser("download")
    p.add_argument("asset_id")
    p.add_argument("--format")
    p.add_argument("--res", help="texture resolution, e.g. 1k/2k/4k (default 1k)")
    p.add_argument("--dir", default="assets")
    args = ap.parse_args()
    {"reindex": cmd_reindex, "search": cmd_search, "info": cmd_info, "download": cmd_download}[args.cmd](args)


if __name__ == "__main__":
    main()
