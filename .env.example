# ---- Director Brain ----
# Backend: "cli" = local `claude` CLI on your Claude MAX plan (no API billing);
#          "api" = Anthropic Messages API (needs ANTHROPIC_API_KEY, scales).
DIRECTOR_MODE=live
DIRECTOR_BACKEND=cli
DIRECTOR_RESEARCH=1
DIRECTOR_CLI_MODEL=opus
CLAUDE_BIN=claude
# only used when DIRECTOR_BACKEND=api:
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-4-8
DIRECTOR_MAX_TOKENS=8000

# ---- OpenRouter (OPTIONAL backup / augmentation — Claude CLI stays primary) ----
# Cheap OpenAI-compatible fallback used for: AI image-prompt enhancement, backup
# LLM routing, and Director failure recovery when the Claude CLI crashes. Leave
# OPENROUTER_API_KEY blank to disable the whole layer (silent no-op — the pipeline
# behaves exactly as before). Get a key at https://openrouter.ai/keys .
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Voice ----
# No hard ElevenLabs dependency. Cascade: ElevenLabs (while it has credit) → Kokoro
# (primary FREE local, CPU) → Piper (emergency local) → espeak → tone. When EL keys
# are blank or credits run out, narration auto-switches to the local engines — free,
# offline, never silent. make_gen.py is unchanged.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Local TTS engines live under data/models/{kokoro,piper} (auto-detected). Install:
#   Kokoro: pip install kokoro-onnx onnxruntime numpy; drop kokoro-v1.0.onnx +
#           voices-v1.0.bin in data/models/kokoro/
#   Piper : extract the piper binary to data/models/piper/piper/ and a voice .onnx
#           (+ .onnx.json) into data/models/piper/
# Two fixed documentary voices only (overridable):
# KOKORO_VOICE_PRIMARY=am_michael          # male dark-history narrator
# KOKORO_VOICE_SECONDARY=am_adam           # secondary
# PIPER_VOICE_PRIMARY=                      # blank → data/models/piper/en_US-ryan-high.onnx
# PIPER_VOICE_SECONDARY=                    # blank → data/models/piper/en_US-lessac-medium.onnx
# TTS_MODELS_DIR=                           # blank → <repo>/data/models

# ---- B-roll ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Cinematic AI images (Google AI Studio ONLY; OpenAI is NOT used) ----
# Get a key at https://aistudio.google.com/apikey . NOTE: image generation needs
# BILLING enabled — the free tier is 0 image requests. Without it, AI beats fall
# back to real footage automatically. AI_IMAGE_DEMO=true = free offline plates.
GOOGLE_API_KEY=
# GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
# GOOGLE_IMAGEN_MODEL=imagen-4.0-generate-001
# Hugging Face Inference Providers = FREE cinematic FLUX images, slotted BETWEEN
# Google and Pollinations. Free with a token that has the "Inference Providers"
# permission (https://huggingface.co/settings/tokens). FLUX.1-dev is preferred;
# FLUX.1-schnell is the fast free fallback (served by hf-inference). Image-only —
# never the director brain. Either env name works (HF_TOKEN wins). Blank → skipped.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_IMAGE_PROVIDER=hf-inference
# HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
# HUGGINGFACE_IMAGE_MODEL_FAST=black-forest-labs/FLUX.1-schnell
# Pollinations = FREE image fallback (no key) used when Google + HF are unavailable.
# Works out of the box on most IPs; a free token (auth.pollinations.ai) lifts the
# rate limit if your IP is throttled. Set POLLINATIONS_ENABLED=false to disable.
# POLLINATIONS_ENABLED=true
# POLLINATIONS_MODEL=flux
# POLLINATIONS_TOKEN=
# AI_IMAGE_DEMO=false

# ---- Local ComfyUI image backend (text->image on THIS machine) ----
# When COMFYUI_ENABLED=1, this is the PRIMARY image generator (a DreamShaper_8_
# pruned SD1.5 text->image graph on a local ComfyUI at :8188). Stills land in the
# normal cache so all downstream editing is unchanged. On ANY failure (ComfyUI not
# running, timeout, etc.) the pipeline falls back automatically to the existing
# chain: Google AI Studio -> HuggingFace FLUX -> Pollinations -> footage.
# (COMFYUI_MODE may be "remote" with a tunnel URL, but local is the default.)
COMFYUI_ENABLED=0
COMFYUI_MODE=local
# Either COMFYUI_BASE_URL or COMFYUI_URL works (alias); COMFYUI_BASE_URL wins if both set.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=900
# Optional tunables (defaults shown):
# COMFYUI_CHECKPOINT=DreamShaper_8_pruned.safetensors
# COMFYUI_WIDTH=512
# COMFYUI_HEIGHT=896
# COMFYUI_STEPS=25
# COMFYUI_CFG=7.0
# COMFYUI_SAMPLER=dpmpp_2m
# COMFYUI_SCHEDULER=karras
# --- CPU-first LCM optimization (Phase 1, opt-in, default OFF) ---
# On a GPU-less i5/12GB box the stock 25-step graph is ~3-5 min/image. COMFYUI_LCM=1
# inserts an LCM-LoRA and renders the SAME checkpoint in ~8 steps (~35-60s on CPU).
# Drop lcm-lora-sdv1-5.safetensors in ComfyUI's models/loras/. OFF = unchanged.
# Launch ComfyUI with scripts/comfyui_cpu.sh; sample graph in data/comfy/cpu_lcm_txt2img.json.
COMFYUI_LCM=0
# COMFYUI_LCM_LORA=lcm-lora-sdv1-5.safetensors
# COMFYUI_LCM_STEPS=8
# COMFYUI_LCM_CFG=2.0
# COMFYUI_LCM_SAMPLER=lcm
# COMFYUI_LCM_SCHEDULER=sgm_uniform
# Lower peak RAM on 12GB: tiled VAE decode.
# COMFYUI_VAE_TILED=1
# COMFYUI_VAE_TILE_SIZE=512
# Anime/cartoon: smaller res + an anime checkpoint + a negative that does NOT ban
# anime (the global default bars cartoon/anime/3d for the photoreal doc look).
# COMFYUI_CHECKPOINT=<your_anime_lcm_model>.safetensors
# COMFYUI_NEGATIVE=lowres, bad anatomy, bad hands, extra fingers, watermark, text, jpeg artifacts

# ---- Premium AI video (leave blank to disable) ----
VEO3_API_KEY=
SEEDANCE_API_KEY=

# ---- AI VIDEO (Pika / Veo3 / Seedance) — disabled by default ----
# Master switch for ALL AI-video generation. OFF keeps the pipeline a stable,
# CPU-friendly local shorts factory (local AI images + real footage + ffmpeg
# motion, no AI video). To re-enable: AI_VIDEO_ENABLED=1 AND set PIKA_API_KEY
# (served via fal.ai's async queue). Costs nothing while disabled.
AI_VIDEO_ENABLED=0
PIKA_API_KEY=
# PIKA_API_BASE=https://queue.fal.run
# PIKA_MODEL=fal-ai/pika/v2.2/text-to-video
# PIKA_RESOLUTION=720p
# PIKA_ASPECT_RATIO=9:16

# ---- Picsart IMAGE-TO-VIDEO (opt-in cinematic motion) ----
# Animates the still LOCAL ComfyUI already generates into a SHORT (3–5s) cinematic
# clip — HERO / high-emotion / anime / dramatic beats only. Fully additive and OFF
# by default: with ENABLE_IMAGE_TO_VIDEO=0 the scene director never allocates an
# ai_video beat and Picsart is never called, so the pipeline behaves EXACTLY as
# before. To turn on: ENABLE_IMAGE_TO_VIDEO=1 AND set PICSART_API_KEY. On a missing
# key or ANY failure the beat degrades to the still (Ken Burns) → real footage —
# never breaks. wan-2.7 + 480p is the cheap/laptop-friendly default; set
# PICSART_MODEL to a Google Veo URN (e.g. urn:air:google:model:google:
# veo-3.1-image-to-video@1) for premium quality at higher cost. MAX_AI_VIDEO_SCENES
# hard-caps clips per short (cost/CPU guard).
ENABLE_IMAGE_TO_VIDEO=0
AI_VIDEO_PROVIDER=picsart
PICSART_API_KEY=
PICSART_MODEL=wan-2.7
MAX_AI_VIDEO_SCENES=2
# Optional quality override — premium model used ONLY for the single hero beat
# (highest-emotion ai_video scene). Blank → every clip uses PICSART_MODEL. Friendly
# names (wan-2.7, veo-3.1-fast, veo-3.1, veo-2.0) resolve to Picsart URNs; a raw
# URN also works.
PICSART_HERO_MODEL=
# Optional tunables (defaults shown):
# PICSART_API_BASE=https://genai-api.picsart.io
# PICSART_I2V_PATH=/v1/image2video
# PICSART_QUALITY=480p
# PICSART_LENGTH_S=4.0
# PICSART_AUDIO=false
# PICSART_POLL_SECONDS=5.0
# PICSART_MAX_WAIT_SECONDS=240.0

# ---- Visual accuracy — narration↔visual GROUNDING LOCK (global rule) ----
# Make every visual show EXACTLY what the line says (point-to-point), across ALL
# niches (history, politics, business, sports, crime, cybersecurity, finance,
# documentary, dark facts, anime). STRICT changes two things:
#   • the Director authors exact, event-grounded keywords per sentence;
#   • the resolver tries those EXACT terms first, then an AI RECREATION of the
#     exact event, and only then generic stock — and never repeats a clip.
# Generic b-roll stays as a non-black safety net (demoted, not forbidden), and
# everyday-realism beats (grocery/streets/crowds) stay real footage. Leave at the
# defaults below for the original behavior; set VISUAL_ACCURACY_MODE=strict to
# turn the lock on (SCENE_GROUNDING / NARRATION_TO_VISUAL_LOCK also enable it).
VISUAL_ACCURACY_MODE=strict
SCENE_GROUNDING=true
NARRATION_TO_VISUAL_LOCK=true

# ---- Render backend (CPU / stability) ----
# "ffmpeg" = pure ffmpeg only (no Node/Remotion) — most stable on a laptop; adds
# cinematic zoom/shake/pan + duration-preserving dip transitions. "auto" = try
# Remotion first, then fall back to ffmpeg. FFMPEG_MOTION_BLUR=1 adds filmic
# motion blur (costs CPU).
RENDER_BACKEND=ffmpeg
FFMPEG_MOTION_BLUR=0

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:////repo/data/factory.db
REMOTION_RENDER_URL=http://localhost:3001
DATA_DIR=/repo/data

# ---- Uploads (Phase 5) ----
YOUTUBE_CLIENT_SECRET_PATH=/repo/config/secrets/youtube_client_secret.json
