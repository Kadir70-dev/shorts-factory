{
  "_comment": "CPU-first SD1.5 + LCM-LoRA txt2img layer graph for ShortsFactory. 8 steps, cfg 2.0, lcm sampler, 512x768, tiled VAE decode for low RAM. Drop POSITIVE/NEGATIVE/SEED in before POSTing to ComfyUI /prompt. ~35-60s/image on an i5 CPU vs ~3-5min for the stock 25-step graph. Used per LAYER (background OR subject) — never AnimateDiff.",
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "DreamShaper_8_pruned.safetensors" }
  },
  "10": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "lora_name": "lcm-lora-sdv1-5.safetensors",
      "strength_model": 1.0,
      "model": ["4", 0]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 768, "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__POSITIVE__", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["4", 1] }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 2.0,
      "sampler_name": "lcm",
      "scheduler": "sgm_uniform",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecodeTiled",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2], "tile_size": 512 }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["8", 0], "filename_prefix": "sf_layer" }
  }
}
